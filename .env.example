# ==== Runtime Security service ====
HOST=0.0.0.0
PORT=8093

# JWT secret for the API (REQUIRED — generate a random value):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RUNTIME_SECURITY_JWT_SECRET=

# Guardian agent autonomy: advisory | semi_autonomous | fully_autonomous
GUARDIAN_AUTONOMY=advisory
GUARDIAN_NOTIFY_WITHIN_SEC=300

# Comma-separated allowlist of outbound hosts the guarded agents may reach.
# Replace with YOUR OWN allowed hosts.
OUTBOUND_HOST_ALLOWLIST=api.anthropic.com,api.openai.com

# ==== Qdrant (memory-integrity checks) ====
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

# ==== Audit + storage ====
AUDIT_DB_PATH=./data/audit.db
FORENSIC_RETENTION_DAYS=90

# ==== Detection thresholds (tunable) ====
DEFAULT_ANOMALY_ZSCORE=3.0
MEMORY_ANOMALY_THRESHOLD_SIGMA=3.0
DATA_EXFIL_VOLUME_SIGMA=3.0
BASELINE_MIN_SESSIONS=5
CREDENTIAL_TTL_HOURS_DEFAULT=24
